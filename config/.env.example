# =====================================================================
# 中哈贸易系统 · 统一凭据配置 —— 模板
#
# 用法：
#   cp config/.env.example config/.env
#   然后按服务器实际情况填写各项，config/.env 不会被提交到 Git。
#
# 全部变量都有代码内默认值，留空即走默认；只有标注「必填」的需要手工配。
# 逐项说明见 config/README.md
# =====================================================================

# ---- 运行期根目录 ----
# 留空 = Java 进程的工作目录（即「cd 到项目根再启动」时的项目根）
# systemd 部署时建议显式指定，例如 /opt/trade
TRADE_HOME=
# Python 解释器（Flask 预测服务用）；留空 = 使用 PATH 中的 python
PYTHON_EXE=

# =====================================================================
# 数据库
# =====================================================================

# ---- 主库：foreign_trade_qa_db（backend-main，端口 8080）----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foreign_trade_qa_db
DB_USERNAME=root
DB_PASSWORD=

# ---- 训练库：trade（backend-training 8081 / Flask app.py 5000）----
TRAIN_DB_HOST=localhost
TRAIN_DB_NAME=trade
TRAIN_DB_USERNAME=root
TRAIN_DB_PASSWORD=

# ---- 大屏库：aj_report（AJ-Report 9095）----
AJ_DB_HOST=localhost
AJ_DB_PORT=3306
AJ_DB_NAME=aj_report
AJ_DB_USERNAME=root
AJ_DB_PASSWORD=
# AJ-Report 新建用户的默认初始密码
AJ_USER_DEFAULT_PASSWORD=

# ---- 系统默认管理员账号（backend-main 的 sys_user 初始账号）----
# deploy/check-health.sh 的登录检查会用到。正式部署请务必改掉。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- pjcait 采集/处理链路使用的 MySQL 库：cait ----
CAIT_DB_HOST=127.0.0.1
CAIT_DB_PORT=3306
CAIT_DB_NAME=cait
CAIT_DB_USERNAME=root
CAIT_DB_PASSWORD=

# =====================================================================
# Neo4j
# =====================================================================

# ---- pjcait 图谱构建链路（kh-trade-news-graph / cait4）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=kh-trade-news-graph
NEO4J_URI_REMOTE=
NEO4J_DATABASE_REMOTE=cait4

# ---- 前端「图谱可视化」页面直连的 Neo4j（frontend-vue/src/api/neo4j.js）----
VUE_APP_NEO4J_URI=bolt://localhost:7687
VUE_APP_NEO4J_USER=neo4j
VUE_APP_NEO4J_PASSWORD=

# =====================================================================
# Redis（pjcait panel 用）
# =====================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# =====================================================================
# JWT 签名密钥
#   ⚠️ 必填。泄露后可伪造任意用户登录令牌。
#      生产环境请换成足够长的随机串，例如：openssl rand -base64 48
# =====================================================================
JWT_SECRET=
# token 有效期（毫秒），默认 86400000 = 1 天
JWT_EXPIRATION=86400000

# =====================================================================
# 大模型 API
# =====================================================================

# ---- DeepSeek（pjcait graph-builder 的 LLM 抽取用）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ---- SiliconFlow（历史脚本中出现过的备用中转）----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# ---- 本地 Qwen3.5-9B 推理服务（智能问答用，OpenAI 兼容接口）----
# 未配置时，问答的 Stage2 LLM 兜底不可用，只能命中关键词路由
QWEN_BASE_URL=
QWEN_CHAT_ENDPOINT=
QWEN_EMBEDDING_ENDPOINT=

# ---- 阿里云 DashScope（backend-main 的 DashScopeClient）----
DASHSCOPE_API_KEY=

# =====================================================================
# 向量检索 Milvus（智能问答 RAG 用，可选）
# =====================================================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=news_corpus
MILVUS_DIMENSION=1024
MILVUS_TOPK=5

# =====================================================================
# 第三方数据接口
# =====================================================================

# ---- UN Comtrade 官方 API（tools/spider-comtrade/get_trade_data.py）----
COMTRADE_API_KEY=

# =====================================================================
# 外部组件地址
# =====================================================================
AJ_REPORT_BASE_URL=http://127.0.0.1:9095
CRAWLER_BASE_URL=http://127.0.0.1:56887
CRAWLER_CALLBACK_BASE_URL=http://127.0.0.1:8080

# =====================================================================
# 前端开发代理（仅 npm run serve 时生效）
# =====================================================================
VUE_APP_BACKEND_URL=http://localhost:8080
VUE_APP_TRAINING_URL=http://localhost:8081
