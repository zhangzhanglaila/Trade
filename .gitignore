# =============================================================================
# 中哈贸易项目 —— 顶层 .gitignore
#
# 仓库范围：源码 + 文档 + 交付物
# 明确排除：大体积模型权重、原始/派生数据集、第三方二进制发行包、构建产物
#
# 设计原则：凡是「能重新下载」或「能重新生成」的大文件都不入库。
# 所有排除项及其原因、恢复方式见 docs/版本控制说明.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 依赖与构建产物（可重新生成）
# -----------------------------------------------------------------------------
node_modules/
target/
dist/
build/
out/
.gradle/
.quasar/
quasar.config.*.temporary.compiled*
*.class

# -----------------------------------------------------------------------------
# 2. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
env/
ENV/
.Python
*.so

# -----------------------------------------------------------------------------
# 3. IDE / 编辑器
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
*.swp
*.swo

# -----------------------------------------------------------------------------
# 4. 操作系统
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# 5. 日志、运行时缓存与临时文件
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
*.orig
*.rej

# AJ-Report 运行时磁盘缓存（EhCache，应用启动时自动生成，含 .lock/.data）
/src/dashboard-ajreport/bin/cache/

# 运行期目录（上传文件 + Jena TDB 图库）——应用启动时自动创建，绝不入库。
# 导入 940 MB RDF 后 TDB 约 1.8 GB，误提交会撑爆仓库。
# 见 docs/服务器部署指南.md §2。
/runtime/

# -----------------------------------------------------------------------------
# 6. 大模型（18.5 GB）—— 不入库
#    两个模型均有独立远端仓库，按需单独拉取：
#      hf-mirror.com/xidrug/qwen3.5-9b-kh-trade-logistics-merged-v1
#      github.com/xidrug/qwen3.5-9b-kh-trade-qa
#    部署时随「模型包」单独上传，见 docs/服务器部署指南.md
# -----------------------------------------------------------------------------
/models/

# -----------------------------------------------------------------------------
# 7. 训练权重（约 113 MB）—— 不入库，随交付包分发
#    位置：src/backend-training/python-scripts/model/trade_Transformer/{in,out}/*.pth
#    说明：LSTM/Transformer 训练产出的模型权重，体积大且为二进制产物；
#         训练曲线图（.png）与编码器（.pkl）体积很小，仍然入库。
# -----------------------------------------------------------------------------
*.pth
*.ckpt
*.onnx
*.h5
*.safetensors

# -----------------------------------------------------------------------------
# 8. data/ 大数据集（约 2.18 GB）—— 不入库，保留说明文件
#    只排除具体的数据目录，各目录下的 README.md 说明仍然入库
# -----------------------------------------------------------------------------
/data/01_原始_海关进出口明细/
/data/02_派生_贸易知识图谱RDF/
/data/03_派生_新闻知识图谱RDF/
/data/04_采集_新闻语料/
/data/05_运行_进出口CSV/出口/
/data/05_运行_进出口CSV/进口/
/data/07_派生_知识图谱构建产物/

# -----------------------------------------------------------------------------
# 9. 第三方二进制发行包 —— 不入库，可自行下载
#    恢复方式见 docs/版本控制说明.md
# -----------------------------------------------------------------------------

# AJ-Report 1.3.0 发行包依赖（lib/ 下为第三方 jar，约 112 MB）
/src/dashboard-ajreport/lib/

# Apache Jena Fuseki 5.4.0 + D2R Server 0.7 发行包（约 60 MB）
/deliverables/查询工具/apache-jena-fuseki-5.4.0/
/deliverables/查询工具/d2r-server-0.7/

# -----------------------------------------------------------------------------
# 10. 统一凭据配置目录 —— 真实值不入库，只保留模板与说明
#     本仓库是公开仓库：config/.env 含明文口令与 API Key，绝不能提交。
#     先忽略整个目录的内容，再反向放行 README.md 与 .env.example。
#     详见 config/README.md
# -----------------------------------------------------------------------------
/config/*
!/config/README.md
!/config/.env.example
