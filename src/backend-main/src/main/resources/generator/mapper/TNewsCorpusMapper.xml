<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tdproject.generator.mapper.TNewsCorpusMapper">

    <resultMap id="BaseResultMap" type="com.example.tdproject.generator.domain.TNewsCorpus">
        <id property="id" column="id"/>
        <result property="newsTitle" column="title"/>
        <result property="newsContent" column="content"/>
        <result property="publishTime" column="publish_time"/>
