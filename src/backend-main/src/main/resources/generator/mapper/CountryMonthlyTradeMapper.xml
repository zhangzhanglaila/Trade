<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tdproject.generator.mapper.CountryMonthlyTradeMapper">

    <resultMap id="BaseResultMap" type="com.example.tdproject.generator.domain.CountryMonthlyTrade">
            <id property="id" column="id" />
            <result property="country" column="country" />
            <result property="year" column="year" />
            <result property="month" column="month" />
            <result property="exportQuantity" column="export_quantity" />
            <result property="exportAmount" column="export_amount" />
            <result property="importQuantity" column="import_quantity" />
            <result property="importAmount" column="import_amount" />
            <result property="totalQuantity" column="total_quantity" />
            <result property="totalAmount" column="total_amount" />
    </resultMap>

    <sql id="Base_Column_List">
        id,country,year,month,export_quantity,export_amount,
        import_quantity,import_amount,total_quantity,total_amount
    </sql>

    <select id="selectLast12MonthsData" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM country_monthly_trade
        WHERE CONCAT(`year`, LPAD(`month`, 2, '0')) >= DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 12 MONTH), '%Y%m')
        AND CONCAT(`year`, LPAD(`month`, 2, '0')) &lt;= DATE_FORMAT(NOW(), '%Y%m')
        ORDER BY `year` ASC, `month` ASC
    </select>
</mapper>
